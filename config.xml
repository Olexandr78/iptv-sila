<?xml version='1.0' encoding='utf-8'?>
<widget id="com.olexandr78.iptvsila" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>IPTV-СИЛА</name>
  <description>IPTV client for iOS 12 and newer</description>
  <content src="index.html" />
  <access origin="*" />
  <allow-navigation href="*" />
  <preference name="deployment-target" value="12.0" />
  <preference name="WKWebViewOnly" value="true" />
  <preference name="ScrollEnabled" value="true" />
  <platform name="ios">
    <edit-config target="NSAppTransportSecurity" file="*-Info.plist" mode="merge">
      <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true />
      </dict>
    </edit-config>
    <edit-config target="NSLocalNetworkUsageDescription" file="*-Info.plist" mode="merge">
      <string>IPTV-СИЛА connects to your IPTV server on the local network.</string>
    </edit-config>
  </platform>
</widget>
